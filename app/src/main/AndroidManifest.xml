<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GitMobApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.GitMob"
        android:supportsRtl="true">

        <!-- configChanges 声明 locale|layoutDirection：语言切换降级为一次普通配置变更，
             appcompat（≤32）与系统（33+）都走"原地更新资源 + onConfigurationChanged"分支，
             不再 recreate → 无黑屏闪烁；Compose 的 stringResource 随 LocalConfiguration
             更新原地重组。全部文案均在组合时解析（无缓存字符串），原地换语言无残留。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="locale|layoutDirection"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 外部 GitHub 链接跳转打开：不加 autoVerify，让系统弹"选择打开方式"，
             详见技能 references/deep-linking.md -->
        <activity
            android:name=".navigation.DeepLinkActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="github.com" />
                <data android:scheme="http" android:host="github.com" />
            </intent-filter>
        </activity>

        <!-- appcompat 官方配方：API ≤32 上把 setApplicationLocales 选择的语言
             持久化并在冷启动时自动恢复（Android 13+ 由系统自己存储，此服务不参与） -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>
</manifest>
