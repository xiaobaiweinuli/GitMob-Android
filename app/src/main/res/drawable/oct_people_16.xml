<?xml version="1.0" encoding="utf-8"?>
<!--
  Octicons people-16 → 组织成员 Members 图标（👥 两个并排站立的人，前景+后景）。
  与 organization-16（建筑外形）语义区分：组织整体用 organization，内部成员列表用 people。
  原版 SVG 有 3 条独立 <path>：第 1 条前景人（大头），第 2 条后景人（小头），第 3 条前景人的头部内嵌圆。
  必须逐条保留，不能合并。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="16dp"
    android:height="16dp"
    android:viewportWidth="16"
    android:viewportHeight="16">
    <!-- 第 1 段：前景大头人物（主要可见的那个人：头部圆+肩宽身体） -->
    <path
        android:fillColor="@android:color/black"
        android:pathData="M2,5.5a3.5,3.5 0,1 1,5.898 2.549 5.508,5.508 0,0 1,3.034 4.084,0.75 0.75,0 1 1,-1.482 0.235 4,4 0,0 0,-7.9 0,0.75 0.75,0 0 1,-1.482 -0.236A5.507,5.507 0,0 1,3.102 8.05 3.493,3.493 0,0 1,2 5.5Z" />
    <!-- 第 2 段：后景小头人物（被前景部分遮挡的后景人：较小头+较小肩宽） -->
    <path
        android:fillColor="@android:color/black"
        android:pathData="M11,4a3.001,3.001 0,0 1,2.22 5.018 5.01,5.01 0,0 1,2.56 3.012,0.749 0.749,0 0 1,-0.885 0.954 0.752,0.752 0,0 1,-0.549 -0.514 3.507,3.507 0,0 0,-2.522 -2.372,0.75 0.75,0 0 1,-0.574 -0.73v-0.352a0.75,0.75 0,0 1,0.416 -0.672A1.5,1.5 0,0 0,11 5.5,0.75 0.75,0 0 1,11 4Z" />
    <!-- 第 3 段：前景人物头部内嵌圆（脸的实心区，与外层头像大圆匹配） -->
    <path
        android:fillColor="@android:color/black"
        android:pathData="M5.5,3.5a2,2 0,1 0,-0.001 3.999A2,2 0,0 0,5.5 3.5Z" />
</vector>
